<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>共享速览</AssemblyName>
    <RootNamespace>IpPathQuickOpen</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\共享速览.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Version>2.0.2</Version>
    <AssemblyTitle>共享速览</AssemblyTitle>
    <Product>共享速览</Product>
    <Company>@老李Oldlee</Company>
    <Copyright>Copyright © @老李Oldlee 2026</Copyright>
    <Description>局域网共享路径自动识别、IP 切换与批量打开工具</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\共享速览.ico" />
    <Resource Include="Assets\共享速览-ui-icon.png" />
    <Resource Include="Assets\老李Oldlee-头像-清晰版.png" />
  </ItemGroup>
</Project>
