<Window x:Class="IpPathQuickOpen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="共享速览" Icon="Assets/共享速览.ico" Width="640" Height="610"
        MinWidth="570" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        LocationChanged="Window_LocationChanged">
    <Grid Margin="18">
        <Border x:Name="Shell" Background="#FAFBFD" CornerRadius="24" BorderBrush="#E6E9EF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#24324A" BlurRadius="28" ShadowDepth="8" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid x:Name="NormalView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="24,24,0,0"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource CircleButton}" Background="#FF5F57"
                                        ToolTip="隐藏到托盘" Click="HideButton_Click"/>
                                <Button Style="{StaticResource CircleButton}" Background="#FEBC2E"
                                        ToolTip="最小化" Click="MinimizeButton_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/共享速览-ui-icon.png" Width="30" Height="30" Margin="0,0,8,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="共享速览" FontFamily="Microsoft YaHei UI" FontSize="16"
                                               FontWeight="SemiBold" Foreground="#182033"/>
                                    <TextBlock Text="Paste · Replace · Open" FontFamily="Segoe UI" FontSize="10"
                                               Foreground="#A0A6B2" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Background="#EAF2FF" Foreground="#2563EB"
                                        Padding="12,7" FontSize="12" Click="CompactButton_Click"
                                        ToolTip="缩成桌面悬浮按钮">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▣" FontFamily="Segoe UI Symbol" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="悬浮窗" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="设置" Style="{StaticResource SecondaryButton}" Padding="14,7"
                                        FontSize="12" Margin="8,0,0,0" Click="SettingsButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,22,28,18">
                            <TextBlock Text="目标服务器" FontSize="12" FontWeight="SemiBold" Foreground="#7C8494"
                                       Margin="2,0,0,8"/>
                            <Border Background="White" CornerRadius="16" BorderBrush="#E8EBF1" BorderThickness="1" Padding="18,13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" Background="#EDF4FF" CornerRadius="11" Margin="0,0,12,0">
                                        <TextBlock Text="IP" Foreground="#2563EB" FontFamily="Segoe UI" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBox x:Name="IpBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                             FontFamily="Segoe UI" FontSize="17" Foreground="#172033"
                                             VerticalContentAlignment="Center" MaxLength="15"/>
                                    <Button Grid.Column="2" Content="保存" Style="{StaticResource SecondaryButton}"
                                            Padding="16,8" FontSize="12" Click="SaveIpButton_Click"/>
                                </Grid>
                            </Border>

                            <Grid Margin="2,20,2,8">
                                <TextBlock Text="共享路径" FontSize="12" FontWeight="SemiBold" Foreground="#7C8494"/>
                                <TextBlock Text="支持多行批量 · 自动清理格式" HorizontalAlignment="Right"
                                           FontSize="11" Foreground="#A0A6B2"/>
                            </Grid>
                            <Border Background="White" CornerRadius="16" BorderBrush="#E8EBF1" BorderThickness="1" Padding="16">
                                <Grid Height="180">
                                    <TextBox x:Name="PathsBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             BorderThickness="0" Background="Transparent" FontFamily="Microsoft YaHei UI"
                                             FontSize="13" Foreground="#293247" TextChanged="PathsBox_TextChanged"
                                             PreviewKeyDown="PathsBox_PreviewKeyDown"/>
                                    <StackPanel x:Name="PastePlaceholder" IsHitTestVisible="False"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="48" Height="48" CornerRadius="15" Background="#F0F5FF"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="⌘" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="#4D76C9"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="点击这里，然后按 Ctrl + V" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#667085" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="一行一条或整段粘贴，软件会自动识别" FontSize="11"
                                                   Foreground="#A0A6B2" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="粘贴并打开" Style="{StaticResource PrimaryButton}"
                                        Click="PasteOpenButton_Click"/>
                                <Button Grid.Column="2" Content="转换预览" Style="{StaticResource SecondaryButton}"
                                        Click="PreviewButton_Click"/>
                                <Button Grid.Column="4" Content="清空" Style="{StaticResource SecondaryButton}"
                                        Click="ClearButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F4F6F9" CornerRadius="0,0,24,24" Padding="24,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#34C759" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Grid.Column="1" Text="准备就绪，等待粘贴路径"
                                       FontSize="12" Foreground="#687184" VerticalAlignment="Center" Margin="9,0"/>
                            <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="4"
                                    Cursor="Hand" VerticalAlignment="Center" Click="CopyrightLink_Click"
                                    ToolTip="打开 https://x.com/oldleeoo">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="24" Height="24" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="Fant">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="Assets/老李Oldlee-头像-清晰版.png" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#7C8EAE" VerticalAlignment="Center">
                                        <Run Text="@老李Oldlee"/><Run Text="  ↗"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="CompactView" Visibility="Collapsed" Background="Transparent"
                      MouseLeftButtonDown="CompactView_MouseLeftButtonDown">
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="粘贴并打开" Click="CompactPasteMenu_Click"/>
                            <MenuItem Header="展开主窗口" Click="ExpandMenu_Click"/>
                            <MenuItem Header="设置" Click="SettingsMenu_Click"/>
                            <Separator/>
                            <MenuItem Header="退出" Click="ExitMenu_Click"/>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="13" Background="#E8F0FF" Margin="14,0,0,0">
                        <Viewbox Width="29" Height="27" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="28" Height="25">
                                <Path Data="M2,5 L10,5 L13,8 L25,8 Q27,8 27,10 L27,22 Q27,24 25,24 L2,24 Q0,24 0,22 L0,7 Q0,5 2,5 Z"
                                      Fill="#2563EB"/>
                                <TextBlock Text="⇄" FontFamily="Segoe UI Symbol" FontSize="15" FontWeight="Bold"
                                           Foreground="White" Canvas.Left="6" Canvas.Top="7"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="CompactPasteButton_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="粘贴并打开" FontSize="14" FontWeight="SemiBold" Foreground="#182033"/>
                            <TextBlock Text="单击或 Ctrl + V" FontSize="10" Foreground="#8D95A5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Content="⋮" FontSize="20" Foreground="#8791A3" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            ToolTip="双击展开主窗口" MouseDoubleClick="CompactExpand_DoubleClick"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
