<Window x:Class="SharedQuickViewInstaller.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装共享速览" Icon="Assets/共享速览.ico" Width="760" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Border Background="#FAFBFD" CornerRadius="26" BorderBrush="#E2E7EF" BorderThickness="1">
            <Border.Effect><DropShadowEffect Color="#213047" BlurRadius="30" ShadowDepth="8" Opacity="0.2"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#EDF4FF" CornerRadius="26,0,0,26">
                    <Grid Margin="24,28,22,24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <Image Source="Assets/共享速览-ui-icon.png" Width="72" Height="72" HorizontalAlignment="Left"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="共享速览" FontSize="21" FontWeight="SemiBold" Foreground="#17233A" Margin="0,12,0,0"/>
                            <TextBlock Text="安装向导 · 2.0.2" FontSize="11" Foreground="#71809A" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,34,0,0">
                            <TextBlock x:Name="Step1Label" Text="01  欢迎" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,7"/>
                            <TextBlock x:Name="Step2Label" Text="02  安装选项" FontSize="13" Foreground="#8B96A8" Margin="0,7"/>
                            <TextBlock x:Name="Step3Label" Text="03  协议与隐私" FontSize="13" Foreground="#8B96A8" Margin="0,7"/>
                            <TextBlock x:Name="Step4Label" Text="04  完成" FontSize="13" Foreground="#8B96A8" Margin="0,7"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Ellipse Width="42" Height="42" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="Fant">
                                <Ellipse.Fill><ImageBrush ImageSource="Assets/老李Oldlee-头像-清晰版.png" Stretch="UniformToFill"/></Ellipse.Fill>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="@老李Oldlee" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="0,26,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid Margin="26,0,18,0">
                            <TextBlock x:Name="PageTitle" Text="欢迎安装" FontSize="17" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="32"
                                    Style="{StaticResource SecondaryButton}" Padding="0" FontSize="18" Click="CloseButton_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="34,26,34,18">
                        <Grid x:Name="WelcomePage">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="让共享路径，打开得更快。" FontSize="26" FontWeight="SemiBold" Foreground="#152238"/>
                                <TextBlock Text="共享速览可自动识别 UNC 共享路径、替换目标 IP，并一次打开多个目录。"
                                           FontSize="13" Foreground="#667085" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="23"/>
                                <Border Background="#F1F6FF" CornerRadius="16" Padding="18" Margin="0,26,0,0">
                                    <StackPanel>
                                        <TextBlock Text="✓  蓝白简约界面与桌面悬浮窗" Foreground="#3A4A63" Margin="0,4"/>
                                        <TextBlock Text="✓  剪贴板自动识别与同 IP 控制" Foreground="#3A4A63" Margin="0,4"/>
                                        <TextBlock Text="✓  本地运行，不上传剪贴板和共享路径" Foreground="#3A4A63" Margin="0,4"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="OptionsPage" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="选择安装位置" FontSize="13" FontWeight="SemiBold" Foreground="#344054"/>
                                <Grid Margin="0,9,0,20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Background="White" BorderBrush="#DCE2EB" BorderThickness="1" CornerRadius="12" Padding="13,10">
                                        <TextBox x:Name="InstallPathBox" BorderThickness="0" Background="Transparent" FontSize="14" Foreground="#263247"/>
                                    </Border>
                                    <Button Grid.Column="2" Content="浏览…" Style="{StaticResource SecondaryButton}" Padding="17,10" Click="BrowseButton_Click"/>
                                </Grid>
                                <TextBlock Text="安装选项" FontSize="13" FontWeight="SemiBold" Foreground="#344054"/>
                                <Border Background="White" BorderBrush="#E2E7EF" BorderThickness="1" CornerRadius="15" Padding="17,10" Margin="0,9,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="DesktopShortcutCheck" Content="创建桌面快捷方式" IsChecked="True" Style="{StaticResource OptionCheck}"/>
                                        <CheckBox x:Name="StartMenuCheck" Content="添加到开始菜单（包含卸载入口）" IsChecked="True" Style="{StaticResource OptionCheck}"/>
                                        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动共享速览" IsChecked="False" Style="{StaticResource OptionCheck}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="安装程序会登记到 Windows“已安装的应用”，以后可从系统设置正常卸载。"
                                           FontSize="11" Foreground="#8791A3" TextWrapping="Wrap" Margin="3,13,3,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="PrivacyPage" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TabControl Background="White" BorderBrush="#DDE3EC">
                                <TabItem Header="用户协议">
                                    <TextBox x:Name="AgreementText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             BorderThickness="0" Padding="14" FontSize="12" Foreground="#48556A" Background="White"/>
                                </TabItem>
                                <TabItem Header="隐私政策">
                                    <TextBox x:Name="PrivacyText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             BorderThickness="0" Padding="14" FontSize="12" Foreground="#48556A" Background="White"/>
                                </TabItem>
                            </TabControl>
                            <CheckBox x:Name="AcceptCheck" Grid.Row="1" Margin="2,15,0,0" Style="{StaticResource OptionCheck}"
                                      Checked="AcceptCheck_Changed" Unchecked="AcceptCheck_Changed">
                                <TextBlock TextWrapping="Wrap"><Run Text="我已阅读并同意《用户协议》和《隐私政策》" FontWeight="SemiBold"/></TextBlock>
                            </CheckBox>
                        </Grid>

                        <Grid x:Name="CompletePage" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="390">
                                <Border Width="72" Height="72" CornerRadius="24" Background="#EAF7EF">
                                    <TextBlock x:Name="CompleteIcon" Text="✓" FontSize="34" Foreground="#26A65B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="CompleteTitle" Text="正在安装…" FontSize="23" FontWeight="SemiBold" Foreground="#17233A"
                                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                <TextBlock x:Name="ProgressStatus" Text="正在准备文件" FontSize="12" Foreground="#748095"
                                           HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                <ProgressBar x:Name="InstallProgress" Height="5" IsIndeterminate="True" Margin="0,24,0,0" Foreground="#2563EB"/>
                                <CheckBox x:Name="LaunchAfterCheck" Content="完成后启动共享速览" IsChecked="True"
                                          Style="{StaticResource OptionCheck}" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2" Background="White" CornerRadius="0,0,26,0" Padding="26,14">
                        <Grid>
                            <Button x:Name="BackButton" Content="上一步" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                                    Padding="19,10" Click="BackButton_Click" Visibility="Collapsed"/>
                            <Button x:Name="NextButton" Content="继续" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                                    Padding="25,10" Click="NextButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
