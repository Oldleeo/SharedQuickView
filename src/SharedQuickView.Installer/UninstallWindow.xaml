<Window x:Class="SharedQuickViewInstaller.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载共享速览" Icon="Assets/共享速览.ico" Width="600" Height="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Border Background="#FAFBFD" CornerRadius="26" BorderBrush="#E2E7EF" BorderThickness="1">
            <Border.Effect><DropShadowEffect Color="#213047" BlurRadius="30" ShadowDepth="8" Opacity="0.2"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="26,26,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="24,0,18,0">
                        <TextBlock Text="卸载共享速览" FontSize="17" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="32"
                                Style="{StaticResource SecondaryButton}" Padding="0" FontSize="18" Click="CloseButton_Click"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="34,27">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image Source="Assets/共享速览-ui-icon.png" Width="78" Height="78" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TitleText" Text="确定要卸载共享速览吗？" FontSize="21" FontWeight="SemiBold" Foreground="#17233A"/>
                        <TextBlock x:Name="DescriptionText" Text="程序文件、桌面快捷方式、开始菜单和开机启动项将被移除。"
                                   FontSize="12" Foreground="#69758A" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="21"/>
                        <CheckBox x:Name="DeleteSettingsCheck" Content="同时删除目标 IP、窗口位置和剪贴板偏好等个人设置"
                                  Style="{StaticResource OptionCheck}" Margin="0,20,0,0"/>
                        <ProgressBar x:Name="UninstallProgress" Height="5" IsIndeterminate="True" Foreground="#2563EB"
                                     Margin="0,22,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="StatusText" FontSize="11" Foreground="#7C879A" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" Background="White" CornerRadius="0,0,26,26" Padding="24,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="36" Height="36" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="Fant">
                                <Ellipse.Fill><ImageBrush ImageSource="Assets/老李Oldlee-头像-清晰版.png" Stretch="UniformToFill"/></Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="@老李Oldlee" Foreground="#7485A1" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}" Padding="20,10" Click="CloseButton_Click"/>
                            <Button x:Name="UninstallButton" Content="确认卸载" Style="{StaticResource PrimaryButton}" Background="#D94A4A"
                                    Padding="22,10" Margin="10,0,0,0" Click="UninstallButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
